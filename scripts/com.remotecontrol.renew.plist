<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  RemoteControl otomatik yenileme servisi (launchd şablonu).
  Doğrudan kopyalamayın: install_auto_renew.sh yer tutucuları doldurup
  ~/Library/LaunchAgents/com.remotecontrol.renew.plist olarak kurar.

  Her 3 saatte bir (ve oturum açılışında) çalışır. Script yalnızca imzanın bitmesine
  24 saatten az kaldığında, yani yaklaşık 6. günde gerçekten yeniler. Mac uykudayken ya da
  kapalıyken kaçırılan denemeler bir sonraki uyanışta otomatik telafi edilir.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.remotecontrol.renew</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__SCRIPT__</string>
		<string>--auto</string>
	</array>

	<key>StartInterval</key>
	<integer>10800</integer>

	<key>RunAtLoad</key>
	<true/>

	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>StandardOutPath</key>
	<string>__LOG_DIR__/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/launchd.err.log</string>
</dict>
</plist>
